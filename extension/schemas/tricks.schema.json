{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tricks.toml",
  "description": "tricks manifest (intent) for a source repo or the user config. Resolved facts live in tricks.lock.",
  "type": "object",
  "definitions": {
    "policy": { "type": "string", "enum": ["review", "auto", "unsafe-auto", "pinned", "paused"], "description": "Update policy. `auto` only for repositories you or your org own; `unsafe-auto` accepts the risk explicitly for third-party repositories." },
    "agent": { "type": "string", "enum": ["claude", "codex", "copilot", "cursor"] }
  },
  "properties": {
    "settings": {
      "type": "object",
      "description": "User settings (~/.config/newtricks/tricks.toml).",
      "properties": {
        "agents": { "type": "array", "items": { "$ref": "#/definitions/agent" }, "description": "Default agents for `add` and dev deployments." },
        "fetch_interval": { "type": "string", "pattern": "^[0-9]+[smhd]$", "default": "24h", "description": "Minimum time between fetches of a repository or catalog." },
        "default_catalogs": { "type": "boolean", "default": true, "description": "Index the built-in default catalogs." },
        "default_sources": { "type": "boolean", "deprecated": true, "description": "Deprecated: renamed to `default_catalogs`." },
        "live": { "type": "array", "items": { "type": "string", "enum": ["skills.sh", "tessl", "clawhub", "github"] }, "description": "Live-query catalogs consulted on each search." }
      },
      "additionalProperties": false
    },
    "source-repos": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Registered source repos: name = path." },
    "workspaces": { "type": "object", "additionalProperties": { "type": "string" }, "deprecated": true, "description": "Deprecated: renamed to `[source-repos]`." },
    "sources": { "type": "object", "deprecated": true, "description": "Deprecated: renamed to `[catalogs]`." },
    "catalogs": {
      "type": "object",
      "description": "Search catalogs keyed by repository, site URL or pointer file.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["repo", "marketplace", "wellknown", "pointers"] },
          "disabled": { "type": "boolean" }
        }
      }
    },
    "source-repo": {
      "type": "object",
      "description": "Source repo settings.",
      "properties": {
        "name": { "type": "string" },
        "agents": { "type": "array", "items": { "$ref": "#/definitions/agent" }, "description": "Agents for dev deployments (default: the user setting)." }
      },
      "additionalProperties": false
    },
    "workspace": { "type": "object", "deprecated": true, "description": "Deprecated: renamed to `[source-repo]`." },
    "skills": {
      "type": "object",
      "description": "User config: canonical id → install request. Source repo: skill name → path/upstream.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "Source repo: directory of the skill relative to the repository root." },
          "upstream": { "type": "string", "pattern": "^[^/]+/.+//.+$", "description": "Canonical upstream id host/owner/repo//path." },
          "track": { "type": "string", "description": "`latest` (highest semver tag, else default branch) or a branch name." },
          "update": { "$ref": "#/definitions/policy" },
          "use": { "type": "string", "description": "Branch variant deployed for everyone." },
          "license-override": { "type": "object", "properties": { "justification": { "type": "string", "minLength": 10 } }, "required": ["justification"] },
          "version": { "type": "string", "description": "User config: `latest` or a tag." },
          "branch": { "type": "string" },
          "rev": { "type": "string" },
          "agents": { "type": "array", "items": { "$ref": "#/definitions/agent" } },
          "mode": { "type": "string", "enum": ["copy"] }
        }
      }
    },
    "lint": {
      "type": "object",
      "properties": {
        "ignore": { "type": "array", "items": { "type": "string", "pattern": "^NT[1-5][0-9]{2}$" } },
        "per-skill": { "type": "object", "additionalProperties": { "type": "object", "properties": { "ignore": { "type": "array", "items": { "type": "string" } } } } }
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["repo"],
            "properties": {
              "repo": { "type": "string", "description": "The distribution repository: owner/repo, host/owner/repo, a git URL, or a path to a repository that accepts pushes." },
              "skills": { "type": "array", "items": { "type": "string" }, "default": ["*"] },
              "exclude": { "type": "array", "items": { "type": "string" }, "description": "Globs relative to each skill directory." },
              "plugins": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } }, "description": "Optional plugin groups for marketplace.json; ungrouped skills go into the default plugin." },
              "marketplace": { "type": "string", "description": "Marketplace name (kebab-case); defaults to the target repository name." },
              "owner": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

{
  "name": "new-tricks",
  "displayName": "New Tricks",
  "description": "Teach your agents new tricks: federated skill search, preview, customize upstream skills, branch experiments, lint and publish.",
  "version": "0.1.0",
  "publisher": "newtricks",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/New-Tricks/Tricks"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters",
    "AI"
  ],
  "keywords": [
    "agent skills",
    "claude code",
    "codex",
    "copilot",
    "cursor",
    "SKILL.md",
    "apm"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:tricks.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tricks",
          "title": "New Tricks",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tricks": [
        {
          "id": "tricks.discover",
          "name": "Discover",
          "type": "webview"
        },
        {
          "id": "tricks.workspace",
          "name": "Workspace",
          "when": "tricks.hasWorkspace"
        },
        {
          "id": "tricks.installed",
          "name": "Installed & Links"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tricks.installed",
        "contents": "No skills installed yet.\nSearch in Discover, then install a skill for your agents.\n[Initialize a workspace](command:tricks.initWorkspace) to author and customize skills."
      }
    ],
    "commands": [
      {
        "command": "tricks.search",
        "title": "Search Skills",
        "category": "New Tricks",
        "icon": "$(search)"
      },
      {
        "command": "tricks.refresh",
        "title": "Refresh",
        "category": "New Tricks",
        "icon": "$(refresh)"
      },
      {
        "command": "tricks.preview",
        "title": "Preview Skill",
        "category": "New Tricks",
        "icon": "$(preview)"
      },
      {
        "command": "tricks.previewFile",
        "title": "Open Supporting File…",
        "category": "New Tricks"
      },
      {
        "command": "tricks.install",
        "title": "Install for Agents…",
        "category": "New Tricks",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tricks.vendor",
        "title": "Vendor into Workspace",
        "category": "New Tricks",
        "icon": "$(repo-forked)"
      },
      {
        "command": "tricks.remove",
        "title": "Remove from Workbench",
        "category": "New Tricks",
        "icon": "$(trash)"
      },
      {
        "command": "tricks.workbenchUpdate",
        "title": "Review Workbench Updates",
        "category": "New Tricks"
      },
      {
        "command": "tricks.rollback",
        "title": "Roll Back",
        "category": "New Tricks"
      },
      {
        "command": "tricks.initWorkspace",
        "title": "Initialize Workspace Here",
        "category": "New Tricks"
      },
      {
        "command": "tricks.newSkill",
        "title": "New Skill…",
        "category": "New Tricks",
        "icon": "$(add)"
      },
      {
        "command": "tricks.lint",
        "title": "Lint Workspace",
        "category": "New Tricks",
        "icon": "$(checklist)"
      },
      {
        "command": "tricks.lintFix",
        "title": "Lint and Apply Safe Fixes",
        "category": "New Tricks"
      },
      {
        "command": "tricks.openSkill",
        "title": "Open SKILL.md",
        "category": "New Tricks"
      },
      {
        "command": "tricks.changes",
        "title": "Show Changes…",
        "category": "New Tricks",
        "icon": "$(diff)"
      },
      {
        "command": "tricks.update",
        "title": "Merge Upstream Changes",
        "category": "New Tricks",
        "icon": "$(git-merge)"
      },
      {
        "command": "tricks.updateContinue",
        "title": "Continue Upstream Merge",
        "category": "New Tricks"
      },
      {
        "command": "tricks.updateAbort",
        "title": "Abort Upstream Merge",
        "category": "New Tricks"
      },
      {
        "command": "tricks.editOnBranch",
        "title": "Edit on Branch…",
        "category": "New Tricks",
        "icon": "$(git-branch)"
      },
      {
        "command": "tricks.commit",
        "title": "Commit Skill…",
        "category": "New Tricks",
        "icon": "$(check)"
      },
      {
        "command": "tricks.useVariant",
        "title": "Use Variant…",
        "category": "New Tricks"
      },
      {
        "command": "tricks.linkToProject",
        "title": "Link to Project…",
        "category": "New Tricks",
        "icon": "$(link)"
      },
      {
        "command": "tricks.unlinkAll",
        "title": "Remove All Test Links",
        "category": "New Tricks"
      },
      {
        "command": "tricks.publish",
        "title": "Publish…",
        "category": "New Tricks",
        "icon": "$(rocket)"
      },
      {
        "command": "tricks.pr",
        "title": "Open Pull Request Upstream…",
        "category": "New Tricks"
      },
      {
        "command": "tricks.doctor",
        "title": "Doctor",
        "category": "New Tricks"
      },
      {
        "command": "tricks.statusActions",
        "title": "Status Actions",
        "category": "New Tricks"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tricks.refresh",
          "when": "view == tricks.workspace || view == tricks.installed",
          "group": "navigation"
        },
        {
          "command": "tricks.newSkill",
          "when": "view == tricks.workspace",
          "group": "navigation"
        },
        {
          "command": "tricks.lint",
          "when": "view == tricks.workspace",
          "group": "navigation"
        },
        {
          "command": "tricks.publish",
          "when": "view == tricks.workspace",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tricks.openSkill",
          "when": "view == tricks.workspace && viewItem =~ /wsSkill/",
          "group": "1_open@1"
        },
        {
          "command": "tricks.changes",
          "when": "view == tricks.workspace && viewItem =~ /vendored/",
          "group": "inline"
        },
        {
          "command": "tricks.update",
          "when": "view == tricks.workspace && viewItem =~ /updateReady/",
          "group": "inline"
        },
        {
          "command": "tricks.editOnBranch",
          "when": "view == tricks.workspace && viewItem =~ /wsSkill/",
          "group": "2_edit@1"
        },
        {
          "command": "tricks.commit",
          "when": "view == tricks.workspace && viewItem =~ /wsSkill/",
          "group": "2_edit@2"
        },
        {
          "command": "tricks.useVariant",
          "when": "view == tricks.workspace && viewItem =~ /wsSkill/",
          "group": "2_edit@3"
        },
        {
          "command": "tricks.linkToProject",
          "when": "view == tricks.workspace && viewItem =~ /wsSkill/",
          "group": "3_deploy@1"
        },
        {
          "command": "tricks.changes",
          "when": "view == tricks.workspace && viewItem =~ /vendored/",
          "group": "4_upstream@1"
        },
        {
          "command": "tricks.update",
          "when": "view == tricks.workspace && viewItem =~ /vendored/",
          "group": "4_upstream@2"
        },
        {
          "command": "tricks.updateContinue",
          "when": "view == tricks.workspace && viewItem =~ /merging/",
          "group": "4_upstream@3"
        },
        {
          "command": "tricks.updateAbort",
          "when": "view == tricks.workspace && viewItem =~ /merging/",
          "group": "4_upstream@4"
        },
        {
          "command": "tricks.pr",
          "when": "view == tricks.workspace && viewItem =~ /vendored/",
          "group": "4_upstream@5"
        },
        {
          "command": "tricks.preview",
          "when": "view == tricks.installed && viewItem == wbSkill",
          "group": "inline"
        },
        {
          "command": "tricks.remove",
          "when": "view == tricks.installed && viewItem == wbSkill",
          "group": "inline"
        },
        {
          "command": "tricks.rollback",
          "when": "view == tricks.installed && viewItem == wbSkill",
          "group": "1@1"
        }
      ],
      "commandPalette": [
        {
          "command": "tricks.openSkill",
          "when": "false"
        },
        {
          "command": "tricks.statusActions",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "New Tricks",
      "properties": {
        "tricks.path": {
          "type": "string",
          "default": "",
          "description": "Path to the tricks binary. Empty uses the bundled binary, then `tricks` on PATH."
        },
        "tricks.offline": {
          "type": "boolean",
          "default": false,
          "description": "Never touch the network (search the local index only)."
        },
        "tricks.checkIntervalMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "description": "How often to check for skill updates while VS Code is open. Fetches are throttled by the workbench fetch_interval."
        },
        "tricks.useGitHubSession": {
          "type": "boolean",
          "default": true,
          "description": "Pass VS Code's GitHub session to tricks (in memory, never stored) when `gh` is not signed in."
        }
      }
    },
    "tomlValidation": [
      {
        "fileMatch": "tricks.toml",
        "url": "./schemas/tricks.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "test": "node ./out/test/protocol.test.js",
    "test:integration": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "~5.9.0"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tricks.toml",
  "description": "tricks workspace or workbench manifest (intent). Resolved facts live in tricks.lock.",
  "type": "object",
  "definitions": {
    "policy": { "type": "string", "enum": ["review", "auto", "unsafe-auto", "pinned", "paused"], "description": "Update policy. `auto` only for sources you or your org own; `unsafe-auto` accepts the risk explicitly for third-party sources." },
    "agent": { "type": "string", "enum": ["claude", "codex", "copilot", "cursor"] }
  },
  "properties": {
    "settings": {
      "type": "object",
      "description": "Workbench settings (~/.config/newtricks/tricks.toml).",
      "properties": {
        "agents": { "type": "array", "items": { "$ref": "#/definitions/agent" }, "description": "Default agents for `add` and dev deployments." },
        "fetch_interval": { "type": "string", "pattern": "^[0-9]+[smhd]$", "default": "24h", "description": "Minimum time between fetches of a source." },
        "default_sources": { "type": "boolean", "default": true, "description": "Index the built-in default skill repositories." }
      },
      "additionalProperties": false
    },
    "workspaces": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Registered workspaces: name = path." },
    "sources": {
      "type": "object",
      "description": "Search sources keyed by repository, site URL or pointer file.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["repo", "marketplace", "wellknown", "pointers"] },
          "disabled": { "type": "boolean" }
        }
      }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "agents": { "type": "array", "items": { "$ref": "#/definitions/agent" } }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "description": "Workbench: canonical id → install request. Workspace: skill name → path/upstream.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "Workspace: directory of the skill relative to the repository root." },
          "upstream": { "type": "string", "pattern": "^[^/]+/.+//.+$", "description": "Canonical upstream id host/owner/repo//path." },
          "track": { "type": "string", "description": "`latest` (highest semver tag, else default branch) or a branch name." },
          "update": { "$ref": "#/definitions/policy" },
          "use": { "type": "string", "description": "Branch variant deployed for everyone." },
          "license-override": { "type": "object", "properties": { "justification": { "type": "string", "minLength": 10 } }, "required": ["justification"] },
          "version": { "type": "string", "description": "Workbench: `latest` or a tag." },
          "branch": { "type": "string" },
          "rev": { "type": "string" },
          "agents": { "type": "array", "items": { "$ref": "#/definitions/agent" } },
          "mode": { "type": "string", "enum": ["copy"] }
        }
      }
    },
    "lint": {
      "type": "object",
      "properties": {
        "ignore": { "type": "array", "items": { "type": "string", "pattern": "^NT[1-5][0-9]{2}$" } },
        "per-skill": { "type": "object", "additionalProperties": { "type": "object", "properties": { "ignore": { "type": "array", "items": { "type": "string" } } } } }
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["repo"],
            "properties": {
              "repo": { "type": "string", "description": "Local checkout of the distribution repository." },
              "skills": { "type": "array", "items": { "type": "string" }, "default": ["*"] },
              "exclude": { "type": "array", "items": { "type": "string" }, "description": "Globs relative to each skill directory." },
              "plugins": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } }, "description": "Optional plugin groups for marketplace.json; ungrouped skills go into the default plugin." },
              "marketplace": { "type": "string", "description": "Marketplace name (kebab-case); defaults to the target directory name." },
              "owner": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

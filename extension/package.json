{
  "name": "new-tricks",
  "displayName": "New Tricks",
  "description": "Teach your agents new tricks: author, customize and test agent skills in a source repo — federated search, vendoring with upstream merges, branch experiments, links for testing, lint and publish.",
  "version": "0.6.1",
  "publisher": "newtricks",
  "license": "Apache-2.0",
  "homepage": "https://new-tricks.github.io/tricks/vscode/",
  "repository": {
    "type": "git",
    "url": "https://github.com/new-tricks/tricks"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters",
    "AI"
  ],
  "keywords": [
    "agent skills",
    "claude code",
    "codex",
    "copilot",
    "cursor",
    "SKILL.md",
    "apm"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:tricks.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tricks",
          "title": "New Tricks",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tricks": [
        {
          "id": "tricks.discover",
          "name": "Discover",
          "type": "webview"
        },
        {
          "id": "tricks.sourceRepo",
          "name": "Source Repo",
          "when": "tricks.hasSourceRepo"
        },
        {
          "id": "tricks.links",
          "name": "Links"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tricks.links",
        "contents": "No links yet.\nLink your source repo's skills to test them with your agents, or try an upstream skill from Discover.\n[Link Source Repo Skills](command:tricks.linkAll)\n[Initialize a source repo](command:tricks.initSourceRepo) to author and customize skills."
      }
    ],
    "commands": [
      {
        "command": "tricks.search",
        "title": "Search Skills",
        "category": "New Tricks",
        "icon": "$(search)"
      },
      {
        "command": "tricks.refresh",
        "title": "Refresh",
        "category": "New Tricks",
        "icon": "$(refresh)"
      },
      {
        "command": "tricks.preview",
        "title": "Preview Skill",
        "category": "New Tricks",
        "icon": "$(preview)"
      },
      {
        "command": "tricks.previewFile",
        "title": "Open Supporting File…",
        "category": "New Tricks"
      },
      {
        "command": "tricks.try",
        "title": "Try in a Project…",
        "category": "New Tricks",
        "icon": "$(beaker)"
      },
      {
        "command": "tricks.vendor",
        "title": "Vendor into Source Repo",
        "category": "New Tricks",
        "icon": "$(repo-forked)"
      },
      {
        "command": "tricks.initSourceRepo",
        "title": "Initialize Source Repo Here",
        "category": "New Tricks"
      },
      {
        "command": "tricks.createSkill",
        "title": "Create Skill…",
        "category": "New Tricks",
        "icon": "$(add)"
      },
      {
        "command": "tricks.removeSkill",
        "title": "Remove Skill…",
        "category": "New Tricks",
        "icon": "$(trash)"
      },
      {
        "command": "tricks.lint",
        "title": "Lint Source Repo",
        "category": "New Tricks",
        "icon": "$(checklist)"
      },
      {
        "command": "tricks.lintFix",
        "title": "Lint and Apply Safe Fixes",
        "category": "New Tricks"
      },
      {
        "command": "tricks.openSkill",
        "title": "Open SKILL.md",
        "category": "New Tricks"
      },
      {
        "command": "tricks.changes",
        "title": "Show Changes…",
        "category": "New Tricks",
        "icon": "$(diff)"
      },
      {
        "command": "tricks.checkUpstream",
        "title": "Check Upstream Changes",
        "category": "New Tricks",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tricks.update",
        "title": "Update from Upstream",
        "category": "New Tricks",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tricks.updateContinue",
        "title": "Continue Update",
        "category": "New Tricks"
      },
      {
        "command": "tricks.updateAbort",
        "title": "Abort Update",
        "category": "New Tricks"
      },
      {
        "command": "tricks.editOnBranch",
        "title": "Experiment on a Branch…",
        "category": "New Tricks",
        "icon": "$(git-branch)"
      },
      {
        "command": "tricks.commitDraft",
        "title": "Commit Draft…",
        "category": "New Tricks",
        "icon": "$(git-commit)"
      },
      {
        "command": "tricks.mergeBranch",
        "title": "Merge Branch…",
        "category": "New Tricks",
        "icon": "$(git-merge)"
      },
      {
        "command": "tricks.editDone",
        "title": "Finish Editing",
        "category": "New Tricks",
        "icon": "$(check)"
      },
      {
        "command": "tricks.useVariant",
        "title": "Use Variant…",
        "category": "New Tricks"
      },
      {
        "command": "tricks.linkAll",
        "title": "Link Source Repo Skills",
        "category": "New Tricks",
        "icon": "$(link)"
      },
      {
        "command": "tricks.linkToProject",
        "title": "Link to Project…",
        "category": "New Tricks",
        "icon": "$(link-external)"
      },
      {
        "command": "tricks.unlink",
        "title": "Unlink / Untry",
        "category": "New Tricks",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "tricks.unlinkAll",
        "title": "Unlink This Source Repo's Skills",
        "category": "New Tricks",
        "icon": "$(clear-all)"
      },
      {
        "command": "tricks.untryAll",
        "title": "Remove All Trials",
        "category": "New Tricks",
        "icon": "$(beaker)"
      },
      {
        "command": "tricks.publish",
        "title": "Publish…",
        "category": "New Tricks",
        "icon": "$(rocket)"
      },
      {
        "command": "tricks.contribute",
        "title": "Contribute Upstream…",
        "category": "New Tricks"
      },
      {
        "command": "tricks.doctor",
        "title": "Doctor",
        "category": "New Tricks"
      },
      {
        "command": "tricks.statusActions",
        "title": "Status Actions",
        "category": "New Tricks"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tricks.refresh",
          "when": "view == tricks.sourceRepo || view == tricks.links",
          "group": "navigation"
        },
        {
          "command": "tricks.createSkill",
          "when": "view == tricks.sourceRepo",
          "group": "navigation"
        },
        {
          "command": "tricks.linkAll",
          "when": "view == tricks.sourceRepo",
          "group": "navigation"
        },
        {
          "command": "tricks.lint",
          "when": "view == tricks.sourceRepo",
          "group": "navigation"
        },
        {
          "command": "tricks.publish",
          "when": "view == tricks.sourceRepo",
          "group": "navigation"
        },
        {
          "command": "tricks.checkUpstream",
          "when": "view == tricks.sourceRepo",
          "group": "1_upstream@1"
        },
        {
          "command": "tricks.unlinkAll",
          "when": "view == tricks.links",
          "group": "navigation"
        },
        {
          "command": "tricks.untryAll",
          "when": "view == tricks.links",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tricks.openSkill",
          "when": "view == tricks.sourceRepo && viewItem =~ /repoSkill/",
          "group": "1_open@1"
        },
        {
          "command": "tricks.changes",
          "when": "view == tricks.sourceRepo && viewItem =~ /vendored/",
          "group": "inline"
        },
        {
          "command": "tricks.update",
          "when": "view == tricks.sourceRepo && viewItem =~ /updateReady/",
          "group": "inline"
        },
        {
          "command": "tricks.editOnBranch",
          "when": "view == tricks.sourceRepo && viewItem =~ /repoSkill/",
          "group": "2_edit@1"
        },
        {
          "command": "tricks.commitDraft",
          "when": "view == tricks.sourceRepo && viewItem =~ /editing/",
          "group": "2_edit@2"
        },
        {
          "command": "tricks.mergeBranch",
          "when": "view == tricks.sourceRepo && viewItem =~ /repoSkill/",
          "group": "2_edit@4"
        },
        {
          "command": "tricks.editDone",
          "when": "view == tricks.sourceRepo && viewItem =~ /editing/",
          "group": "2_edit@2"
        },
        {
          "command": "tricks.useVariant",
          "when": "view == tricks.sourceRepo && viewItem =~ /repoSkill/",
          "group": "2_edit@3"
        },
        {
          "command": "tricks.linkToProject",
          "when": "view == tricks.sourceRepo && viewItem =~ /repoSkill/",
          "group": "3_link@1"
        },
        {
          "command": "tricks.changes",
          "when": "view == tricks.sourceRepo && viewItem =~ /vendored/",
          "group": "4_upstream@1"
        },
        {
          "command": "tricks.update",
          "when": "view == tricks.sourceRepo && viewItem =~ /vendored/",
          "group": "4_upstream@2"
        },
        {
          "command": "tricks.updateContinue",
          "when": "view == tricks.sourceRepo && viewItem =~ /updating/",
          "group": "4_upstream@3"
        },
        {
          "command": "tricks.updateAbort",
          "when": "view == tricks.sourceRepo && viewItem =~ /updating/",
          "group": "4_upstream@4"
        },
        {
          "command": "tricks.contribute",
          "when": "view == tricks.sourceRepo && viewItem =~ /vendored/",
          "group": "4_upstream@5"
        },
        {
          "command": "tricks.unlink",
          "when": "view == tricks.links && (viewItem == link || viewItem == trial)",
          "group": "inline"
        },
        {
          "command": "tricks.mergeBranch",
          "when": "view == tricks.sourceRepo && viewItem == branch",
          "group": "inline"
        },
        {
          "command": "tricks.removeSkill",
          "when": "view == tricks.sourceRepo && viewItem =~ /repoSkill/",
          "group": "9_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "tricks.openSkill",
          "when": "false"
        },
        {
          "command": "tricks.statusActions",
          "when": "false"
        },
        {
          "command": "tricks.unlink",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "New Tricks",
      "properties": {
        "tricks.path": {
          "type": "string",
          "default": "",
          "description": "Path to the tricks binary. Empty uses the bundled binary, then `tricks` on PATH."
        },
        "tricks.offline": {
          "type": "boolean",
          "default": false,
          "description": "Never touch the network (search the local index only)."
        },
        "tricks.checkIntervalMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "description": "How often to check vendored skills for upstream changes while VS Code is open. Fetches are throttled by the fetch_interval in your user config."
        },
        "tricks.useGitHubSession": {
          "type": "boolean",
          "default": true,
          "description": "Pass VS Code's GitHub session to tricks (in memory, never stored) when `gh` is not signed in."
        }
      }
    },
    "tomlValidation": [
      {
        "fileMatch": "tricks.toml",
        "url": "./schemas/tricks.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "test": "node ./out/test/protocol.test.js && node ./out/test/webview.test.js",
    "test:integration": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.0"
  }
}
